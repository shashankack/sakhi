# Server-only (used by Next.js route handlers on Vercel / local)
# Full URL to Integration BFF chat endpoint (via cloudflared tunnel)
CHAT_API_URL=http://127.0.0.1:3001/api/chat

# Base URL of Whisper STT tunnel (no trailing slash). Optional.
# Expects POST {STT_API_URL}/transcribe → { "text": "..." }
STT_API_URL=
