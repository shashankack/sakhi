{
  "name": "aai",
  "version": "0.1.0",
  "private": true,
  "description": "Aai  non-diagnostic PCOS symptom education (hackathon)",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @aai/api",
