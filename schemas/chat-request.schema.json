{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saheli.local/schemas/chat-request.schema.json",
  "title": "ChatRequest",
  "type": "object",
  "required": ["message"],
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4000
    },
    "history": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    },
    "locale": {
      "type": "string",
      "enum": ["auto", "en", "hi", "kn"],
      "default": "auto"
    }
  }
}
